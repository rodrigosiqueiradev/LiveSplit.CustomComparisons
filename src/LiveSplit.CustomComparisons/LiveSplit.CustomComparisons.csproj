<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Must match LiveSplit itself. -->
    <TargetFramework>net481</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>LiveSplit.CustomComparisons</AssemblyName>
    <RootNamespace>LiveSplit.CustomComparisons</RootNamespace>
    <Version>0.2.0</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <!--
    Where your LiveSplit install lives (the folder with LiveSplit.exe), in order of preference:
      1. dotnet build -p:LiveSplitDir="D:\Tools\LiveSplit"
      2. local.props in the repository root (git-ignored), see README
      3. the LIVESPLIT_DIR environment variable
  -->
  <Import Project="..\..\local.props" Condition="Exists('..\..\local.props')" />
  <PropertyGroup>
    <LiveSplitDir Condition="'$(LiveSplitDir)' == ''">$(LIVESPLIT_DIR)</LiveSplitDir>
  </PropertyGroup>

  <Target Name="CheckLiveSplitDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(LiveSplitDir)' == '' Or !Exists('$(LiveSplitDir)\LiveSplit.Core.dll')"
           Text="Can't find LiveSplit (looked in '$(LiveSplitDir)'). Point LiveSplitDir at the folder containing LiveSplit.exe: see 'Build' in README.md." />
  </Target>

  <ItemGroup>
    <!-- Lets you build without installing the .NET Framework 4.8.1 targeting pack. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Provided by LiveSplit at runtime, so never copied next to our DLL. -->
    <Reference Include="LiveSplit.Core">
      <HintPath>$(LiveSplitDir)\LiveSplit.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UpdateManager">
      <HintPath>$(LiveSplitDir)\UpdateManager.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!--
      WebView2 for the block editor. LiveSplit already ships these with its Racetime
      component, so we use its copies and never ship our own (no version clashes).
    -->
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>$(LiveSplitDir)\Components\Microsoft.Web.WebView2.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms">
      <HintPath>$(LiveSplitDir)\Components\Microsoft.Web.WebView2.WinForms.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
    <EditorDir>$(MSBuildThisFileDirectory)..\..\editor\</EditorDir>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The block editor page, built from ../../editor with `npm run build`.
      Embedded so the component stays a single DLL. Served from memory, never from disk.
    -->
    <EmbeddedResource Include="EditorDist\**\*" LogicalName="editor/%(RecursiveDir)%(Filename)%(Extension)" />

    <!-- The editor's sources, so changing them rebuilds this project (also in Visual Studio). -->
    <EditorSource Include="$(EditorDir)src\**\*;$(EditorDir)static\**\*;$(EditorDir)scripts\**\*;$(EditorDir)package.json;$(EditorDir)tsconfig.json" />
    <UpToDateCheckInput Include="@(EditorSource)" />
  </ItemGroup>

  <!--
    Rebuilds the block editor when its sources are newer than the built page, so one build
    (dotnet build, or F5 in Visual Studio) does everything. Needs Node.js (npm) on PATH.
    Turn it off with -p:BuildEditor=false to build the editor yourself.
  -->
  <Target Name="BuildEditor" BeforeTargets="BeforeBuild" Condition="'$(BuildEditor)' != 'false'"
          Inputs="@(EditorSource)" Outputs="EditorDist\editor.js">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(EditorDir)" Condition="!Exists('$(EditorDir)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(EditorDir)" />
    <!-- Pick up files the build just created (the item list above was made before it ran). -->
    <ItemGroup>
      <_BuiltEditorFile Include="EditorDist\**\*" />
      <EmbeddedResource Remove="EditorDist\**\*" />
      <EmbeddedResource Include="@(_BuiltEditorFile)"
                        LogicalName="editor/%(_BuiltEditorFile.RecursiveDir)%(_BuiltEditorFile.Filename)%(_BuiltEditorFile.Extension)" />
    </ItemGroup>
  </Target>

  <Target Name="CheckEditorBuilt" AfterTargets="BuildEditor" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('EditorDist\index.html') Or !Exists('EditorDist\editor.js')"
           Text="The block editor hasn't been built. Run: cd editor; npm install; npm run build" />
  </Target>

  <ItemGroup>
    <!--
      Compile the engine straight into this assembly so runners install a single DLL.
      The engine stays a separate project only so it can be tested without LiveSplit.
    -->
    <Compile Include="..\CustomComparisons.Engine\**\*.cs" Exclude="..\CustomComparisons.Engine\obj\**;..\CustomComparisons.Engine\bin\**" LinkBase="Engine" />
  </ItemGroup>

  <!--
    Copies the DLL (and its .pdb, for breakpoints) into LiveSplit's Components folder.
    On by default when building in Visual Studio, so F5 runs LiveSplit with the fresh build
    (see Properties\launchSettings.json). Elsewhere: dotnet build -p:DeployToLiveSplit=true.
    Set DeployToLiveSplit to false in local.props to turn it off.
  -->
  <PropertyGroup>
    <DeployToLiveSplit Condition="'$(DeployToLiveSplit)' == '' And '$(BuildingInsideVisualStudio)' == 'true'">true</DeployToLiveSplit>
  </PropertyGroup>
  <Target Name="DeployToLiveSplit" AfterTargets="Build" Condition="'$(DeployToLiveSplit)' == 'true'">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(LiveSplitDir)\Components"
          SkipUnchangedFiles="true" Retries="1" RetryDelayMilliseconds="500" ContinueOnError="true">
      <Output TaskParameter="CopiedFiles" ItemName="DeployedFiles" />
    </Copy>
    <Error Condition="'$(MSBuildLastTaskResult)' == 'false'"
           Text="Couldn't copy the component into '$(LiveSplitDir)\Components'. Is LiveSplit still running? Close it and build again." />
    <Message Importance="high" Condition="'@(DeployedFiles)' != ''" Text="Deployed to $(LiveSplitDir)\Components" />
  </Target>

</Project>
